<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    每用户安装：默认装到 %LOCALAPPDATA%\Programs\VideoGrabber，
    安装过程不需要管理员权限；可在 UI 中改安装目录。
  -->
  <Package Name="Video Grabber"
           Manufacturer="Video Grabber"
           Version="0.2.0"
           UpgradeCode="BC8AAAD9-6175-42EC-BEAB-C3718285CA4D"
           Scope="perUser"
           Language="2052"
           Codepage="65001"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 Video Grabber，请先卸载后再安装。" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\src\VideoGrabber.App\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Launch Condition="Installed OR VersionNT &gt;= 601"
            Message="Video Grabber 需要 Windows 7 或更高版本。" />

    <Feature Id="Main" Title="Video Grabber" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="VideoGrabber" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <!-- 发布目录里的全部文件；由 wix build 的 -d PublishDir=<publish 目录> 提供（以 \ 结尾）。 -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuShortcutDir" Name="Video Grabber">
        <Component Id="StartMenuShortcut" Guid="BC2A9FB1-5BB6-49F9-8E30-580416C07E18">
          <Shortcut Id="AppShortcut"
                    Name="Video Grabber"
                    Description="下载网页视频"
                    Icon="AppIcon"
                    Target="[INSTALLFOLDER]VideoGrabber.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveProgramMenuShortcutDir" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\VideoGrabber" Name="installed"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Fragment>

</Wix>
