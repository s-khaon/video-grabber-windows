<Window x:Class="VideoGrabber.App.Views.MediaRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修复本地视频文件"
        Icon="Assets/app.ico"
        Height="520" Width="760" MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="修复本地视频文件" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="先检查能否解码；能救的文件会原地无损重新封装，必要时转码。原文件损坏时保留修复后的新文件。"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,14,0,0" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="#FAFBFC" BorderBrush="{StaticResource LineBrush}" />

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="关闭" Width="96"
                    Style="{StaticResource BaseButton}" Click="Close_Click" />
            <ProgressBar x:Name="Progress" Height="6" VerticalAlignment="Center" Margin="0,0,16,0"
                         Foreground="{StaticResource AccentBrush}" Background="#EDEFF2" BorderThickness="0" />
        </DockPanel>
    </Grid>
</Window>
