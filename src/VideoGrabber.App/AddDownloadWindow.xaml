<Window x:Class="VideoGrabber.App.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增下载" Icon="Assets/app.ico" Width="680" Height="640" MinHeight="540" MinWidth="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}" FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconTile}">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="新增下载" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="粘贴链接后解析清晰度，也可以一次粘贴多条按顺序下载"
                               Style="{StaticResource PageSubtitle}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="视频链接" Style="{StaticResource SectionTitle}" />
                        <TextBox Height="96" Margin="0,10,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Text="{Binding Links, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="支持一次粘贴多条链接，每条一行；批量任务会串行执行。" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="从剪贴板粘贴" Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                                    Command="{Binding PasteCommand}" />
                            <Button Content="解析" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                    Command="{Binding ProbeCommand}" IsEnabled="{Binding IsNotProbing}" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 解析结果 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                        Visibility="{Binding HasProbe, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Border Width="112" Height="63" CornerRadius="6" Background="{DynamicResource CanvasBrush}"
                                ClipToBounds="True">
                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProbeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProbeMeta}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="清晰度" Style="{StaticResource SectionTitle}" />
                                <ComboBox Margin="0,8,0,0" ItemsSource="{Binding QualityOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedQuality, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="容器" Style="{StaticResource SectionTitle}" />
                                <ComboBox Margin="0,8,0,0" ItemsSource="{Binding ContainerOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedContainer, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ContainerHint}" Style="{StaticResource Caption}" Margin="0,8,0,0" />

                        <CheckBox Content="复用内置浏览器保存的 Cookies" IsChecked="{Binding UseCookies, Mode=TwoWay}"
                                  Margin="0,16,0,0" />
                        <TextBlock Text="{Binding CookieHint}" Style="{StaticResource Caption}" Margin="0,6,0,0" />

                        <TextBlock Text="保存目录" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="选择…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="加入队列" Style="{StaticResource PrimaryButton}" Command="{Binding EnqueueCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
