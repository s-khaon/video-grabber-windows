<Window x:Class="VideoGrabber.App.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增下载" Icon="Assets/app.ico" Width="660" Height="600" MinHeight="520" MinWidth="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}" FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="链接" Style="{StaticResource SectionTitle}" />
            <TextBox Height="80" Margin="0,8,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     Text="{Binding Links, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="支持一次粘贴多条链接，每条一行；批量任务会串行执行。" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="从剪贴板粘贴" Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                        Command="{Binding PasteCommand}" />
                <Button Content="解析" Style="{StaticResource BaseButton}" Margin="0,0,12,0"
                        Command="{Binding ProbeCommand}" IsEnabled="{Binding IsNotProbing}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="380" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>
                <!-- 解析结果 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding HasProbe, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Border Width="112" Height="63" CornerRadius="6" Background="#EDEFF2" ClipToBounds="True">
                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProbeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProbeMeta}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="清晰度" Style="{StaticResource SectionTitle}" />
                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding QualityOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedQuality, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="容器" Style="{StaticResource SectionTitle}" />
                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding ContainerOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedContainer, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding ContainerHint}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />

                <StackPanel Margin="0,16,0,0">
                    <CheckBox Content="复用内置浏览器保存的 Cookies" IsChecked="{Binding UseCookies, Mode=TwoWay}" />
                    <TextBlock Text="{Binding CookieHint}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="保存目录" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="选择…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                            Command="{Binding BrowseCommand}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="加入队列" Style="{StaticResource PrimaryButton}" Command="{Binding EnqueueCommand}" />
        </StackPanel>
    </Grid>
</Window>
