<Window x:Class="VideoGrabber.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:VideoGrabber.Core.Models;assembly=VideoGrabber.Core"
        mc:Ignorable="d"
        Title="Video Grabber"
        Height="760" Width="1120" MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddDownloadCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding SettingsCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- 任务详情：完整信息 + 日志 -->
        <DataTemplate DataType="{x:Type models:DownloadJob}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UrlString}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{Binding BytesText}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="继续下载" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                IsEnabled="{Binding CanResume}"
                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="重试" Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                                IsEnabled="{Binding CanRetry}"
                                Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="取消" Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                                IsEnabled="{Binding CanCancel}"
                                Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="打开所在文件夹" Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                                Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="删除任务" Style="{StaticResource DangerButton}"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>

                    <!-- 进度 -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding BytesText}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding ProgressDetailText}" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <ProgressBar Height="6" Margin="0,10,0,0" Maximum="1" Minimum="0"
                                         Value="{Binding Progress, Mode=OneWay}"
                                         Foreground="{StaticResource AccentBrush}" Background="#EDEFF2"
                                         BorderThickness="0" />
                            <TextBlock Text="{Binding CommandPreview}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" FontFamily="Consolas"
                                       Visibility="{Binding CommandPreview, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- 失败原因 -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Background="#FDF3F3" BorderBrush="#F2C9C9"
                            Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding FailureMessage}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="{Binding FailureHint}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="#8A3B3B"
                                       Visibility="{Binding FailureHint, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- 任务信息 -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="引擎" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EngineText}" FontSize="13" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="清晰度" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Quality.Label}" FontSize="13" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="容器" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ContainerText}" FontSize="13" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="保存目录" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SaveDirectory}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="代理" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProxyDescription}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="产物" Style="{StaticResource Caption}" />
                            <ItemsControl Grid.Row="5" Grid.Column="1" ItemsSource="{Binding OutputFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- 日志 -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="日志" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="260"
                                     FontFamily="Consolas" FontSize="11.5" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="#FAFBFC" BorderThickness="0"
                                     TextChanged="LogBox_TextChanged" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- 侧栏条目 -->
        <DataTemplate x:Key="JobItemTemplate" DataType="{x:Type models:DownloadJob}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Style="{StaticResource Caption}"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ProgressBar Height="3" Margin="0,7,0,0" Maximum="1" Minimum="0"
                             Value="{Binding Progress, Mode=OneWay}"
                             Foreground="{StaticResource AccentBrush}" Background="#EDEFF2" BorderThickness="0" />
                <TextBlock Text="{Binding ProgressDetailText}" Style="{StaticResource Caption}" Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 菜单 -->
        <Menu Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="6,2" BorderBrush="{StaticResource LineBrush}"
              BorderThickness="0,0,0,1">
            <MenuItem Header="文件(_F)" Padding="8,4">
                <MenuItem Header="新增下载…" Command="{Binding AddDownloadCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="设置…" Command="{Binding SettingsCommand}" InputGestureText="Ctrl+," />
                <Separator />
                <MenuItem Header="打开默认保存目录" Click="OpenFolder_Click" />
                <Separator />
                <MenuItem Header="退出" Click="Exit_Click" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="队列(_Q)" Padding="8,4">
                <MenuItem Header="全部取消" Command="{Binding CancelAllCommand}" />
                <MenuItem Header="清理已完成" Command="{Binding ClearFinishedCommand}" />
                <Separator />
                <MenuItem Header="重新检测下载工具" Command="{Binding RefreshToolsCommand}" />
            </MenuItem>
            <MenuItem Header="帮助(_H)" Padding="8,4">
                <MenuItem Header="什么是 yt-dlp / ffmpeg？" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏 -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,14,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Video Grabber" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding QueueHeader}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="新增下载" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddDownloadCommand}" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16,10,16,14">
                        <Button Content="全部取消" Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                                Command="{Binding CancelAllCommand}" />
                        <Button Content="清理已完成" Style="{StaticResource BaseButton}" Command="{Binding ClearFinishedCommand}" />
                    </StackPanel>

                    <Grid>
                        <ListBox x:Name="JobList" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource JobItemTemplate}" ItemContainerStyle="{StaticResource JobListItem}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        <TextBlock Text="{Binding QueueEmptyHint}" Style="{StaticResource Caption}" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,32,24,0"
                                   Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 详情 -->
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding SelectedJob}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding SelectedJob, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                    <TextBlock Text="选择一个任务查看详情" FontSize="15" Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="下载进度、失败原因、命令预览与完整日志都会显示在这里。" Style="{StaticResource Caption}"
                               Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="重新检测" Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                            Command="{Binding RefreshToolsCommand}" />
                    <Button Content="设置" Style="{StaticResource BaseButton}" Command="{Binding SettingsCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#3FA45B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasToolWarning}" Value="True">
                                        <Setter Property="Fill" Value="#D64545" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ToolStatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ToolWarningText}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                               Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasToolWarning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
