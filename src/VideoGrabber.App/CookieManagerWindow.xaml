<Window x:Class="VideoGrabber.App.CookieManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cookie 管理"
        Height="580"
        Width="780"
        MinHeight="420"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Icon="Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconTile}">
                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Cookie 管理" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,2,0,0"
                               Text="导出的 Netscape Cookie 会与下载共用；删除站点时同时清理浏览器 Cookie、localStorage 与 IndexedDB。" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,14,24,0">
            <Button x:Name="RefreshButton" Style="{StaticResource BaseButton}" Content="刷新" Click="Refresh_Click" />
            <Button x:Name="RevealButton" Style="{StaticResource BaseButton}" Content="打开文件夹" Margin="8,0,0,0" Click="Reveal_Click" />
            <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="删除选中" Margin="8,0,0,0" Click="Delete_Click" />
            <Button x:Name="ClearAllButton" Style="{StaticResource DangerButton}" Content="清空全部" Margin="8,0,0,0" Click="ClearAll_Click" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="24,12,24,0">
            <Grid>
                <ListBox x:Name="EntryList" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="14,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Host}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}">
                                    <Run Text="{Binding CookieCount}" /><Run Text=" 条" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Width="150"
                                           Foreground="{DynamicResource SecondaryTextBrush}">
                                    <Run Text="{Binding FileSize, StringFormat={}{0:N0}}" /><Run Text=" 字节" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Text="还没有保存任何 Cookie。用内置浏览器打开页面后点「保存 Cookies」。"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Caption}" Margin="24,10,24,14"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
