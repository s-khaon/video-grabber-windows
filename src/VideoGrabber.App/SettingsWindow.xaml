<Window x:Class="VideoGrabber.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="720" Height="760" MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}" FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 工具 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="下载工具" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="{Binding Tools.StatusSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                <Button Content="重新检测" Style="{StaticResource BaseButton}" Command="{Binding RefreshToolsCommand}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="留空时自动在 PATH、WinGet、Scoop、Chocolatey 等位置查找。" Style="{StaticResource Caption}" Margin="0,6,0,12" />

                        <TextBlock Text="yt-dlp" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.YtDlpPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="浏览…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseYtDlpCommand}" />
                        </Grid>

                        <TextBlock Text="ffmpeg" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.FfmpegPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="浏览…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseFfmpegCommand}" />
                        </Grid>

                        <TextBlock Text="ffprobe（留空时按 ffmpeg 同目录查找）" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.FfprobePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="浏览…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseFfprobeCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 下载 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="下载" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="默认保存目录" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.DefaultSaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="选择…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseDownloadDirectoryCommand}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="同时下载数（1–6）" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding ConcurrencyOptions}"
                                          SelectedItem="{Binding Settings.MaxConcurrentDownloads, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="限速（如 5M，留空不限）" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Settings.RateLimit, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="默认清晰度" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding DefaultQualityOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedDefaultQuality, Mode=TwoWay}" />

                        <CheckBox Content="失败或取消后保留未完成的临时文件（用于续传）" Margin="0,14,0,0"
                                  IsChecked="{Binding Settings.KeepIncompleteTempFiles, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 代理 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="代理" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="通过代理访问网络" Margin="0,10,0,0"
                                  IsChecked="{Binding Settings.ProxyEnabled, Mode=TwoWay}" />
                        <TextBlock Text="代理地址（HTTP，默认本机 Clash 的 7897 端口；socks5 会自动推导）" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.ProxyUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="测试连通性" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Command="{Binding TestProxyCommand}" IsEnabled="{Binding IsNotTestingProxy}" />
                        </Grid>
                        <TextBlock Text="{Binding ProxyTestResult}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ProxyTestResult, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- 高级 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="高级" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="额外的 yt-dlp 参数（按空格拆分，支持引号）" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding Settings.ExtraArguments, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="例如：--limit-rate 2M --retries 10" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" Style="{StaticResource PrimaryButton}" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
