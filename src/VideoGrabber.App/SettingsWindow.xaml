<Window x:Class="VideoGrabber.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Icon="Assets/app.ico" Width="720" Height="760" MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}" FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource HeaderIconTile}">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="工具路径、下载偏好、浏览器与代理" Style="{StaticResource PageSubtitle}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>
                <!-- 工具 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="下载工具" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="{Binding Tools.StatusSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                <Button Content="重新检测" Style="{StaticResource BaseButton}" Command="{Binding RefreshToolsCommand}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="留空时自动在 PATH、WinGet、Scoop、Chocolatey 等位置查找。" Style="{StaticResource Caption}" Margin="0,6,0,12" />

                        <TextBlock Text="yt-dlp" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.YtDlpPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="浏览…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseYtDlpCommand}" />
                        </Grid>

                        <TextBlock Text="ffmpeg" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.FfmpegPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="浏览…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseFfmpegCommand}" />
                        </Grid>

                        <TextBlock Text="ffprobe（留空时按 ffmpeg 同目录查找）" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.FfprobePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="浏览…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseFfprobeCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 下载 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="下载" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="默认保存目录" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.DefaultSaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="选择…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseDownloadDirectoryCommand}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="同时下载数（1–6）" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding ConcurrencyOptions}"
                                          SelectedItem="{Binding Settings.MaxConcurrentDownloads, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="限速（如 5M，留空不限）" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Settings.RateLimit, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="默认清晰度" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding DefaultQualityOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedDefaultQuality, Mode=TwoWay}" />

                        <CheckBox Content="失败或取消后保留未完成的临时文件（用于续传）" Margin="0,14,0,0"
                                  IsChecked="{Binding Settings.KeepIncompleteTempFiles, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 浏览器 / 自动接管 / 广告拦截 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="浏览器与自动接管" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="内置浏览器拦截广告（EasyList 离线规则）" Margin="0,10,0,0"
                                  IsChecked="{Binding Settings.AdBlockEnabled, Mode=TwoWay}" Click="Option_Changed" />
                        <CheckBox Content="下载失败时自动用后台浏览器接管，嗅探真实地址后重下" Margin="0,8,0,0"
                                  IsChecked="{Binding Settings.AutoTakeoverEnabled, Mode=TwoWay}" Click="Option_Changed" />
                        <CheckBox Content="接管成功后记住站点，以后直接走嗅探并跳过 yt-dlp" Margin="0,8,0,0"
                                  IsChecked="{Binding Settings.RememberSniffSites, Mode=TwoWay}" Click="Option_Changed" />

                        <TextBlock Text="广告拦截白名单（这些站点不拦截）" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding WhitelistInput, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="输入域名，例如 example.com" />
                            <Button Grid.Column="1" Content="添加" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Command="{Binding AddWhitelistCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Whitelist}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BaseButton}" Margin="0,0,6,6" Padding="8,3"
                                            Command="{Binding DataContext.RemoveWhitelistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="点一下从白名单移除">
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="清空白名单" Style="{StaticResource BaseButton}" HorizontalAlignment="Left"
                                Margin="0,2,0,0" Command="{Binding ClearWhitelistCommand}" />

                        <TextBlock Text="已记住「直接嗅探」的站点" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                        <ItemsControl ItemsSource="{Binding SniffHosts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BaseButton}" Margin="0,0,6,6" Padding="8,3"
                                            Command="{Binding DataContext.RemoveSniffHostCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="点一下取消该站点的嗅探策略">
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="清空站点记忆" Style="{StaticResource BaseButton}" HorizontalAlignment="Left"
                                Command="{Binding ClearSniffHostsCommand}" />

                        <TextBlock Text="浏览器数据" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Cookie 管理…" Style="{StaticResource BaseButton}" Click="OpenCookieManager_Click" />
                            <Button Content="打开内置浏览器…" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Click="OpenBrowser_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 代理 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="代理" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="通过代理访问网络" Margin="0,10,0,0"
                                  IsChecked="{Binding Settings.ProxyEnabled, Mode=TwoWay}" />
                        <TextBlock Text="代理地址（HTTP，默认本机 Clash 的 7897 端口；socks5 会自动推导）" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.ProxyUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="测试连通性" Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                    Command="{Binding TestProxyCommand}" IsEnabled="{Binding IsNotTestingProxy}" />
                        </Grid>
                        <TextBlock Text="{Binding ProxyTestResult}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ProxyTestResult, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- 高级 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="高级" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="额外的 yt-dlp 参数（按空格拆分，支持引号）" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding Settings.ExtraArguments, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="例如：--limit-rate 2M --retries 10" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭" Style="{StaticResource PrimaryButton}" Click="Close_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
