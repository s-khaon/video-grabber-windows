<Window x:Class="VideoGrabber.App.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="内置浏览器 · 资源嗅探"
        Icon="Assets/app.ico"
        Height="760" Width="1240" MinHeight="520" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="‹" Width="32" Style="{StaticResource BaseButton}" Click="Back_Click" ToolTip="后退" />
                    <Button x:Name="ForwardButton" Content="›" Width="32" Margin="6,0,0,0" Style="{StaticResource BaseButton}" Click="Forward_Click" ToolTip="前进" />
                    <Button Content="⟳" Width="32" Margin="6,0,10,0" Style="{StaticResource BaseButton}" Click="Reload_Click" ToolTip="刷新" />
                </StackPanel>

                <TextBox x:Name="AddressBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                         Padding="10,0" KeyDown="AddressBox_KeyDown"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="打开" Width="64" HorizontalAlignment="Right" Margin="0,0,6,0"
                        Style="{StaticResource BaseButton}" Click="Go_Click" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="保存 Cookies" Style="{StaticResource BaseButton}" Click="SaveCookies_Click" />
                    <Button Content="清理会话" Style="{StaticResource BaseButton}" Margin="6,0,0,0" Click="ClearSession_Click" />
                    <ToggleButton x:Name="ShieldButton" Content="{Binding ShieldText}" Margin="10,0,0,0" Padding="10,4"
                                  Background="#F4F6F9" BorderBrush="{StaticResource LineBrush}"
                                  ToolTip="广告拦截总开关；点击可临时关闭当前站点"
                                  Click="Shield_Click" />
                    <CheckBox Content="嗅探" Margin="12,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding SniffEnabled, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="380" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <wv2:WebView2 x:Name="Browser" Grid.Column="0" />

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E6E9EE" />

            <Border Grid.Column="2" Background="#FBFCFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="资源嗅探" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="播放视频后这里会出现可下载的地址" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="92" VerticalAlignment="Center"
                                  ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}" />
                        <Button Grid.Column="2" Content="清空" Margin="6,0,0,0" Style="{StaticResource BaseButton}" Click="ClearSniff_Click" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding CookieStatus}" Foreground="#1F7A3D"
                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />

                    <ListBox x:Name="ResourceList" Grid.Row="2" Margin="0,10,0,0"
                             ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#EAF4FF" CornerRadius="6" Padding="6,2"
                                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="#1559A6" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#5A6472" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" Visibility="{Binding DetailVisibility}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding BlobHintVisibility}">
                                            <TextBlock Text="blob 地址不能直接下载，可改用相关联的 m3u8。" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <Button Content="用关联 m3u8 下载" Margin="8,0,0,0" Style="{StaticResource BaseButton}" Click="BlobDownload_Click" />
                                        </StackPanel>

                                        <ListBox ItemsSource="{Binding Variants}" Margin="0,8,0,0"
                                                 SelectedItem="{Binding SelectedVariant, Mode=TwoWay}"
                                                 Visibility="{Binding VariantVisibility}"
                                                 Background="Transparent" BorderThickness="0" Focusable="False"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,2" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6" Padding="8,6">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F7F9FC" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Background" Value="#EAF2FE" />
                                                                        <Setter Property="BorderBrush" Value="#1F6FEB" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <Border DockPanel.Dock="Right" Background="#FFF3D6" CornerRadius="5" Padding="5,1" Margin="6,0,0,0"
                                                                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#8A5A00" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Technical}" Style="{StaticResource Caption}" />
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Duration}" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding Size}" Style="{StaticResource Caption}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="下载" Style="{StaticResource BaseButton}"
                                                                    VerticalAlignment="Center" Click="VariantDownload_Click" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Caption}"
                                                   Foreground="#1559A6" Margin="0,6,0,0"
                                                   Visibility="{Binding SelectionVisibility}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="复制" Style="{StaticResource BaseButton}" Click="Copy_Click" />
                                            <Button Content="yt-dlp" Style="{StaticResource BaseButton}" Margin="6,0,0,0" Click="DownloadYtDlp_Click" />
                                            <Button Content="ffmpeg 直连" Style="{StaticResource BaseButton}" Margin="6,0,0,0" Click="DownloadDirect_Click" />
                                            <Button Content="转换为 mp4…" Style="{StaticResource BaseButton}" Margin="6,0,0,0" Click="Convert_Click" />
                                            <Button Content="重新解析" Style="{StaticResource BaseButton}" Margin="6,0,0,0" Click="Reinspect_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3" Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
