<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 System.Windows.Forms.NotifyIcon，避免引入第三方 UI 包。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VideoGrabber</AssemblyName>
    <RootNamespace>VideoGrabber.App</RootNamespace>
    <Version>0.2.2</Version>
    <!-- exe 文件图标（资源管理器 / 任务栏 / 快捷方式）。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 的 global using 会和 WPF 的 Application / MessageBox 冲突，这里移除。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- 窗口图标与托盘图标从资源流加载。 -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 广告拦截规则：与 macOS 版同一份离线产物，运行时零网络请求。 -->
    <Content Include="Assets\AdBlock\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoGrabber.Core\VideoGrabber.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
